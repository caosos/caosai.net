# CAOS backend environment template
# Copy to .env on the server. Never commit real secrets.

CAOS_ENV=development
CAOS_APP_NAME=CAOS
CAOS_LOG_LEVEL=INFO
CAOS_DEV_AUTH_ENABLED=true

# MongoDB
MONGO_URI=
MONGO_DB_NAME=caos

# Providers: values intentionally blank here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# OAuth: production-only; disabled during foundation phase.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# Optional integrations
GITHUB_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
